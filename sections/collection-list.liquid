<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="cat-grid">
      {%- for block in section.blocks -%}
        {%- assign c = collections[block.settings.collection] -%}
        <a class="cat noise" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" data-reveal {{ block.shopify_attributes }}>
          {%- if c.featured_image != blank -%}
            <img src="{{ c.featured_image | image_url: width: 600 }}" alt="{{ c.title | escape }}" width="600" height="800" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.4">
          {%- endif -%}
          <span class="cat__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <div style="position:relative;z-index:1">
            <h3>{{ block.settings.title | default: c.title }}</h3>
            <span>{% if c != blank %}{{ c.all_products_count }} produktów{% else %}Zobacz {% render 'icon', icon: 'arrow-right' %}{% endif %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lista kategorii",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "KATEGORIE" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Czego dziś potrzebujesz?" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategoria",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kolekcja" },
        { "type": "text", "id": "title", "label": "Tytuł (opcjonalny)" },
        {
          "type": "select", "id": "icon", "label": "Ikona", "default": "flashlight",
          "options": [
            { "value": "flashlight", "label": "Latarka" },
            { "value": "camera", "label": "Kamera" },
            { "value": "wrench", "label": "Klucz" },
            { "value": "box", "label": "Pudełko" },
            { "value": "shield", "label": "Tarcza" },
            { "value": "zap", "label": "Błyskawica" },
            { "value": "thermometer", "label": "Termometr" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Lista kategorii",
      "blocks": [
        { "type": "category", "settings": { "title": "Oświetlenie", "icon": "flashlight" } },
        { "type": "category", "settings": { "title": "Inspekcja", "icon": "camera" } },
        { "type": "category", "settings": { "title": "Narzędzia & EDC", "icon": "wrench" } },
        { "type": "category", "settings": { "title": "Organizacja", "icon": "box" } }
      ]
    }
  ]
}
{% endschema %}
