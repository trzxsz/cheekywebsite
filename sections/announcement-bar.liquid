{%- if section.settings.text != blank -%}
  <div class="announcement">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
    {{ section.settings.text }}
    {%- if section.settings.link != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Pasek ogłoszeń",
  "settings": [
    { "type": "text", "id": "text", "label": "Tekst", "default": "Darmowa wysyłka od 199 zł · Wysyłka 24h · 30 dni na zwrot" },
    { "type": "url", "id": "link", "label": "Link (opcjonalny)" }
  ],
  "presets": [{ "name": "Pasek ogłoszeń" }]
}
{% endschema %}
