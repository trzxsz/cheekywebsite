<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      <span class="eyebrow">KOLEKCJE</span>
      <h1 style="font-size:clamp(2rem,5vw,3.4rem);margin-top:.5rem">Wszystkie kategorie</h1>
    </div>
    <div class="cat-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a class="cat noise" href="{{ collection.url }}" data-reveal>
            {%- if collection.featured_image != blank -%}
              <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" width="600" height="800" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.4">
            {%- endif -%}
            <span class="cat__icon">{% render 'icon', icon: 'package' %}</span>
            <div style="position:relative;z-index:1">
              <h3>{{ collection.title }}</h3>
              <span>{{ collection.all_products_count }} produktów</span>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Lista kolekcji", "settings": [] }
{% endschema %}
