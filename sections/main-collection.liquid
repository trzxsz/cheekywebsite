{%- paginate collection.products by 12 -%}
<section class="section">
  <div class="container">
    <div class="section-head" data-reveal style="max-width:none">
      <span class="eyebrow">{{ collection.all_products_count }} produktów</span>
      <h1 style="font-size:clamp(2rem,5vw,3.4rem);margin-top:.6rem">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<p>{{ collection.description }}</p>{%- endif -%}
    </div>

    <div class="collection__bar">
      <button class="btn btn--ghost collection__filter-toggle" type="button" data-filters-toggle>
        {% render 'icon', icon: 'layout-grid' %} Filtry
      </button>
      <form method="get" class="collection__sort">
        <label class="mono muted" for="sort">Sortuj:</label>
        <select id="sort" name="sort_by" data-auto-submit>
          {%- for opt in collection.sort_options -%}
            <option value="{{ opt.value }}"{% if opt.value == collection.sort_by %} selected{% endif %}>{{ opt.name }}</option>
          {%- endfor -%}
        </select>
        {%- for f in collection.filters -%}{%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}{%- endfor -%}
      </form>
    </div>

    <div class="collection__layout{% if collection.filters.size == 0 %} collection__layout--nofilters{% endif %}">

      {%- if collection.filters.size > 0 -%}
        <aside class="collection__filters" data-filters>
          <form method="get">
            {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'list' or filter.type == 'boolean' -%}
                <div class="filter">
                  <h4 class="mono">{{ filter.label }}</h4>
                  <div class="filter__values">
                    {%- for value in filter.values -%}
                      <a class="filter__chip{% if value.active %} is-active{% endif %}" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}">
                        {{ value.label }} <span class="muted">{{ value.count }}</span>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </form>
        </aside>
      {%- endif -%}

      <div>
        {%- if collection.products.size > 0 -%}
          <div class="product-grid">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination mono mt-3">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--ghost">←</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}" class="pg">{{ part.title }}</a>
                {%- else -%}<span class="pg{% if part.title == paginate.current_page %} is-current{% endif %}">{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--ghost">→</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="surface" style="padding:3rem;text-align:center">
            <p class="muted">Brak produktów w tej kolekcji.</p>
            <a class="btn btn--primary mt-3" href="{{ routes.all_products_collection_url }}">Zobacz wszystkie produkty</a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-auto-submit]').forEach(function(s){ s.addEventListener('change', function(){ s.form.submit(); }); });
  var ft = document.querySelector('[data-filters-toggle]'); var fa = document.querySelector('[data-filters]');
  if(ft && fa){ ft.addEventListener('click', function(){ fa.classList.toggle('is-open'); }); }
</script>
{%- endpaginate -%}

{% schema %}
{ "name": "Kolekcja", "settings": [] }
{% endschema %}
