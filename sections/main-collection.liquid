{% render 'swietlik-assets' %}
{%- paginate collection.products by 24 -%}
<section class="sw pm-catalog section">
  <div class="sw-container">

    <header class="pm-catalog__head" data-reveal>
      <p class="sw-kicker">Katalog</p>
      <h1 class="pm-catalog__title">{{ collection.title | default: 'Produkty' }}</h1>
      {%- if collection.description != blank -%}<p class="pm-catalog__desc">{{ collection.description }}</p>{%- endif -%}
    </header>

    <div class="pm-catalog__grid">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          <a class="pm-tile" href="{{ product.url }}" data-reveal>
            <div class="pm-tile__media">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" width="700" height="700" loading="lazy">
              {%- else -%}
                <div class="pm-tile__ph">{% render 'icon', icon: 'flashlight' %}</div>
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}<span class="pm-tile__badge">Promocja</span>{%- endif -%}
            </div>
            <div class="pm-tile__body">
              <h3 class="pm-tile__name">{{ product.title }}</h3>
              <div class="pm-tile__price">
                <span class="pm-tile__now">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}<span class="pm-tile__old">{{ product.compare_at_price | money }}</span>{%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Brak produktów w Shopify — pokaż kafelek Magnesówki {%- endcomment -%}
        <a class="pm-tile" href="{{ routes.root_url }}" data-reveal>
          <div class="pm-tile__media">
            <img src="{{ 'swietlik-2.jpg' | asset_url }}" alt="Magnesówka — magnetyczna lampa warsztatowa LED" width="700" height="700" loading="lazy">
            <span class="pm-tile__badge">Bestseller</span>
          </div>
          <div class="pm-tile__body">
            <h3 class="pm-tile__name">Magnesówka</h3>
            <div class="pm-tile__price">
              <span class="pm-tile__now">249 zł</span>
              <span class="pm-tile__old">329 zł</span>
            </div>
          </div>
        </a>
      {%- endif -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pm-catalog__pager mono">
        {%- if paginate.previous -%}<a class="sw-btn sw-btn--ghost" href="{{ paginate.previous.url }}">← Poprzednia</a>{%- endif -%}
        {%- if paginate.next -%}<a class="sw-btn sw-btn--ghost" href="{{ paginate.next.url }}">Następna →</a>{%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Kolekcja", "settings": [] }
{% endschema %}
