<section class="section">
  <div class="container">
    <div class="iwt {% if section.settings.reverse %}iwt--reverse{% endif %}">
      <div class="iwt__media noise" data-reveal>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading | escape }}" width="1200" height="900" loading="lazy" style="width:100%;height:100%;object-fit:cover">
        {%- else -%}
          <div class="media-ph" style="--ph-accent:var(--molten)">{% render 'icon', icon: 'flashlight' %}</div>
        {%- endif -%}
      </div>
      <div data-reveal data-reveal-delay="1">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="mt-2" style="font-size:clamp(1.8rem,4vw,3rem)">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="muted mt-2">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn--primary btn--lg magnetic mt-3" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label }} {% render 'icon', icon: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Obraz z tekstem",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Obraz" },
    { "type": "checkbox", "id": "reverse", "label": "Odwróć układ", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "AUTOMOTIVE LIFESTYLE" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Zbudowane dla tych, którzy nie odpuszczają" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Każdy produkt NOCTRA przechodzi testy w realnych warunkach — od garażu po bezdroża. Bez kompromisów, bez taniej plastikowej tandety.</p>" },
    { "type": "text", "id": "button_label", "label": "Przycisk — tekst", "default": "Poznaj markę" },
    { "type": "url", "id": "button_link", "label": "Przycisk — link" }
  ],
  "presets": [{ "name": "Obraz z tekstem" }]
}
{% endschema %}
