{%- liquid
  if section.settings.collection != blank
    assign coll = collections[section.settings.collection]
  else
    assign coll = collections.all
  endif
  assign limit = section.settings.products_count | default: 8
-%}
<section class="section" id="bestsellers">
  <div class="container">
    <div class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    {%- if coll.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="surface" style="padding:2rem;text-align:center">
        <p class="muted">Dodaj produkty do kolekcji w panelu Shopify, aby wyświetlić je tutaj.</p>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="center mt-3" data-reveal>
        <a class="btn btn--ghost btn--lg" href="{{ section.settings.button_link | default: coll.url | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }} {% render 'icon', icon: 'arrow-right' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Polecane produkty",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "TOP WYBÓR KIEROWCÓW" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Bestsellery" },
    { "type": "text", "id": "subheading", "label": "Podtytuł", "default": "Najczęściej wybierany sprzęt NOCTRA. Sprawdzony w garażu i w terenie." },
    { "type": "collection", "id": "collection", "label": "Kolekcja" },
    { "type": "range", "id": "products_count", "min": 4, "max": 12, "step": 1, "label": "Liczba produktów", "default": 8 },
    { "type": "text", "id": "button_label", "label": "Przycisk — tekst", "default": "Zobacz wszystkie" },
    { "type": "url", "id": "button_link", "label": "Przycisk — link" }
  ],
  "presets": [{ "name": "Polecane produkty" }]
}
{% endschema %}
