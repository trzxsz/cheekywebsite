<section class="section">
  <div class="container">
    <div class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="testi-grid">
      {%- for block in section.blocks -%}
        <figure class="testi" data-reveal data-reveal-delay="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="testi__stars">
            {%- assign r = block.settings.rating | default: 5 -%}
            {%- for i in (1..r) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
          </div>
          <blockquote><p>“{{ block.settings.quote }}”</p></blockquote>
          <figcaption class="testi__author">{% render 'icon', icon: 'check' %} {{ block.settings.author }}{% if block.settings.role != blank %} · {{ block.settings.role }}{% endif %}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Opinie",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "4.9/5 · PONAD 3000 OPINII" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Kierowcy nam ufają" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Opinia",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Treść", "default": "Świetny sprzęt." },
        { "type": "text", "id": "author", "label": "Autor", "default": "Marek W." },
        { "type": "text", "id": "role", "label": "Podpis (opcjonalny)", "default": "Zweryfikowany zakup" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Ocena", "default": 5 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Opinie",
      "blocks": [
        { "type": "quote", "settings": { "quote": "Magnes trzyma lampę na masce jak przyspawany. Światło mocne i równe — robota w garażu to teraz przyjemność.", "author": "Tomasz R.", "rating": 5 } },
        { "type": "quote", "settings": { "quote": "Endoskop USB-C podłączyłem do telefonu i od razu znalazłem przyczynę stuku w silniku. Bezcenne.", "author": "Kasia D.", "rating": 5 } },
        { "type": "quote", "settings": { "quote": "Zamówiłem w piątek, w poniedziałek było. Jakość premium, czuć różnicę od pierwszego chwytu.", "author": "Paweł S.", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}
