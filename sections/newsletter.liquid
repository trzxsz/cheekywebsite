<section class="section">
  <div class="container">
    <div class="newsletter noise bg-radial-molten" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="mt-2" style="font-size:clamp(1.8rem,4vw,2.8rem)">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted mt-1" style="max-width:46ch;margin-inline:auto">{{ section.settings.text }}</p>{%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="mt-3" style="color:var(--molten)">{% render 'icon', icon: 'check' %} Dzięki! Sprawdź skrzynkę.</p>
        {%- else -%}
          <div class="newsletter" style="border:0;padding:0;background:none">
            <div style="display:flex;gap:.6rem;max-width:460px;margin:1.6rem auto 0;flex-wrap:wrap">
              <input type="email" name="contact[email]" placeholder="Twój e-mail" required aria-label="E-mail" style="flex:1;min-width:200px">
              <button type="submit" class="btn btn--primary magnetic">Zapisz się {% render 'icon', icon: 'arrow-right' %}</button>
            </div>
          </div>
        {%- endif -%}
      {%- endform -%}
      <p class="mono muted mt-2" style="font-size:.72rem">-10% na pierwsze zamówienie · Zero spamu.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "DOŁĄCZ DO ZAŁOGI" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "-10% na start" },
    { "type": "text", "id": "text", "label": "Tekst", "default": "Zapisz się i odbierz kod rabatowy. Premiery, dropy i porady prosto na maila." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
