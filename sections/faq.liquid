<section class="section">
  <div class="container">
    <div class="section-head center" style="text-align:center;margin-inline:auto" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="faq" data-accordion data-reveal>
      {%- for block in section.blocks -%}
        <div class="faq__item" {{ block.shopify_attributes }}>
          <button class="faq__q" type="button" aria-expanded="false">
            {{ block.settings.question }} {% render 'icon', icon: 'plus' %}
          </button>
          <div class="faq__a"><div>{{ block.settings.answer }}</div></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Nadtytuł", "default": "MASZ PYTANIA?" },
    { "type": "text", "id": "heading", "label": "Nagłówek", "default": "Najczęstsze pytania" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pytanie",
      "settings": [
        { "type": "text", "id": "question", "label": "Pytanie", "default": "Pytanie?" },
        { "type": "richtext", "id": "answer", "label": "Odpowiedź", "default": "<p>Odpowiedź.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item", "settings": { "question": "Jak szybko realizujecie zamówienia?", "answer": "<p>Zamówienia złożone do 14:00 wysyłamy tego samego dnia roboczego. Dostawa zwykle trwa 1–2 dni robocze.</p>" } },
        { "type": "item", "settings": { "question": "Czy mogę zwrócić produkt?", "answer": "<p>Tak — masz 30 dni na zwrot bez podania przyczyny. Zwracamy pełną kwotę po otrzymaniu produktu.</p>" } },
        { "type": "item", "settings": { "question": "Jak działa gwarancja?", "answer": "<p>Każdy produkt objęty jest 2-letnią gwarancją. W razie wady wymieniamy sprzęt na nowy.</p>" } },
        { "type": "item", "settings": { "question": "Czy endoskop zadziała z moim telefonem?", "answer": "<p>Modele z USB-C działają bezpośrednio. Do starszych telefonów z Lightning potrzebny jest adapter OTG.</p>" } }
      ]
    }
  ]
}
{% endschema %}
