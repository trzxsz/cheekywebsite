[
  {
    "name": "theme_info",
    "theme_name": "NOCTRA",
    "theme_version": "1.0.0",
    "theme_author": "NOCTRA Performance",
    "theme_documentation_url": "https://github.com/trzxsz/cheekywebsite",
    "theme_support_url": "https://github.com/trzxsz/cheekywebsite/issues"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (opcjonalne — domyślnie tekst NOCTRA)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 240,
        "step": 10,
        "unit": "px",
        "label": "Szerokość logo",
        "default": 140
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Nazwa marki",
        "default": "NOCTRA"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Slogan",
        "default": "Own the dark."
      }
    ]
  },
  {
    "name": "Kolory",
    "settings": [
      { "type": "header", "content": "Powierzchnie" },
      { "type": "color", "id": "color_bg", "label": "Tło", "default": "#0a0a0c" },
      { "type": "color", "id": "color_surface", "label": "Karty / sekcje", "default": "#16161c" },
      { "type": "color", "id": "color_line", "label": "Linie / obramowania", "default": "#2a2a33" },
      { "type": "header", "content": "Tekst" },
      { "type": "color", "id": "color_text", "label": "Tekst", "default": "#f5f5f4" },
      { "type": "color", "id": "color_muted", "label": "Tekst drugorzędny", "default": "#9a9aa6" },
      { "type": "header", "content": "Akcenty" },
      { "type": "color", "id": "color_molten", "label": "Akcent główny (molten)", "default": "#ff4d2e" },
      { "type": "color", "id": "color_ember", "label": "Akcent pomocniczy (ember)", "default": "#ff9500" },
      { "type": "color", "id": "color_volt", "label": "Akcent elektryczny (volt)", "default": "#2e7bff" }
    ]
  },
  {
    "name": "Układ",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Maksymalna szerokość strony",
        "default": 1340
      }
    ]
  },
  {
    "name": "Koszyk",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Typ koszyka",
        "options": [
          { "value": "drawer", "label": "Wysuwany (drawer)" },
          { "value": "page", "label": "Strona koszyka" }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Próg darmowej wysyłki (w walucie sklepu, 0 = wyłączone)",
        "default": 199
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" }
    ]
  }
]
