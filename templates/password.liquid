<section class="section noise" style="min-height:100vh;display:grid;place-items:center;text-align:center">
  <div class="bg-radial-molten" style="position:absolute;inset:0;z-index:0"></div>
  <div class="bg-grid" style="position:absolute;inset:0;z-index:0;opacity:.5"></div>
  <div class="container" style="max-width:520px;position:relative;z-index:1">
    <div class="header__logo" style="font-size:2.6rem">{{ shop.name }}<span>.</span></div>
    <span class="eyebrow mt-3" style="justify-content:center">WKRÓTCE</span>
    <h1 class="text-steel mt-2" style="font-size:clamp(2.2rem,6vw,3.6rem)">Coś mocnego<br>nadjeżdża.</h1>
    <p class="muted mt-2">Sklep otwiera się już niedługo. Masz hasło? Wejdź.</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-errors mt-3">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div style="display:flex;gap:.6rem;max-width:420px;margin:1.6rem auto 0;flex-wrap:wrap">
        <input type="password" name="password" placeholder="Hasło" aria-label="Hasło" style="flex:1;min-width:180px;background:var(--surface);border:1px solid var(--line);border-radius:99px;padding:.9rem 1.3rem">
        <button type="submit" class="btn btn--primary magnetic">Wejdź</button>
      </div>
    {%- endform -%}

    <p class="mono muted mt-3" style="font-size:.72rem">{{ powered_by_link }}</p>
  </div>
</section>
