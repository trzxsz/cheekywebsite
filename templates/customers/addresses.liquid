<section class="section">
  <div class="container" style="max-width:760px">
    <div class="section-head"><span class="eyebrow">KONTO</span><h1 style="font-size:clamp(1.8rem,4vw,2.4rem);margin-top:.5rem">Twoje adresy</h1></div>
    <a class="btn btn--ghost" href="{{ routes.account_url }}">{% render 'icon', icon: 'arrow-right' %} Wróć do konta</a>

    {%- paginate customer.addresses by 5 -%}
      <div class="mt-3" style="display:flex;flex-direction:column;gap:1rem">
        {%- for address in customer.addresses -%}
          <div class="surface" style="padding:1.3rem">
            {%- if address == customer.default_address -%}<span class="badge badge--bestseller">Domyślny</span>{%- endif -%}
            <div class="mt-2">{{ address | format_address }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endpaginate -%}

    <h3 class="mt-3" style="margin-bottom:1rem">Dodaj nowy adres</h3>
    {%- form 'customer_address', customer.new_address -%}
      <div class="field"><label>Imię</label><input type="text" name="address[first_name]"></div>
      <div class="field"><label>Nazwisko</label><input type="text" name="address[last_name]"></div>
      <div class="field"><label>Adres</label><input type="text" name="address[address1]"></div>
      <div class="field"><label>Miasto</label><input type="text" name="address[city]"></div>
      <div class="field"><label>Kod pocztowy</label><input type="text" name="address[zip]"></div>
      <div class="field"><label>Kraj</label><select name="address[country]">{{ country_option_tags }}</select></div>
      <div class="field"><label>Telefon</label><input type="tel" name="address[phone]"></div>
      <button type="submit" class="btn btn--primary magnetic">Zapisz adres</button>
    {%- endform -%}
  </div>
</section>
