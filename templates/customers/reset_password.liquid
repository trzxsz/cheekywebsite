<section class="section">
  <div class="container auth">
    <div class="section-head" style="text-align:center"><span class="eyebrow" style="justify-content:center">KONTO</span><h1 style="font-size:2rem;margin-top:.5rem">Ustaw nowe hasło</h1></div>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="np">Nowe hasło</label><input type="password" name="customer[password]" id="np" required autocomplete="new-password"></div>
      <div class="field"><label for="npc">Powtórz hasło</label><input type="password" name="customer[password_confirmation]" id="npc" required autocomplete="new-password"></div>
      <button type="submit" class="btn btn--primary btn--block magnetic">Zmień hasło</button>
    {%- endform -%}
  </div>
</section>
