<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- comment -%} Fonts {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <title>
      {{ page_title }}
      {%- if current_page != 1 %} &ndash; {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%} Theme settings -> CSS variables {%- endcomment -%}
    <style>
      :root {
        --ink: {{ settings.color_bg }};
        --surface: {{ settings.color_surface }};
        --line: {{ settings.color_line }};
        --text: {{ settings.color_text }};
        --muted: {{ settings.color_muted }};
        --molten: {{ settings.color_molten }};
        --ember: {{ settings.color_ember }};
        --volt: {{ settings.color_volt }};
        --page-width: {{ settings.page_width | default: 1340 }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      window.NOCTRA = {
        moneyFormat: {{ shop.money_format | json }},
        cartType: {{ settings.cart_type | json }},
        freeShipping: {{ settings.free_shipping_threshold | default: 0 | json }},
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        }
      };
      document.documentElement.classList.remove('no-js');
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link btn" href="#main" style="position:absolute;left:-9999px">Przejdź do treści</a>

    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'search-overlay' %}
    <div class="backdrop" data-backdrop></div>

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
