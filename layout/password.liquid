<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      :root {
        --ink: {{ settings.color_bg }};
        --surface: {{ settings.color_surface }};
        --line: {{ settings.color_line }};
        --text: {{ settings.color_text }};
        --muted: {{ settings.color_muted }};
        --molten: {{ settings.color_molten }};
        --ember: {{ settings.color_ember }};
        --volt: {{ settings.color_volt }};
        --page-width: {{ settings.page_width | default: 1340 }}px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    {{ content_for_layout }}
  </body>
</html>
